generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for easy local/dev setup. For real multi-institution production
  // deployment, switch provider to "postgresql" and point DATABASE_URL at
  // a Postgres instance - the schema below is compatible with both.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so Role / AttendanceType are plain
// strings here, constrained via the Role / AttendanceType TS union types
// (see src/types.ts) and validated with zod at every write.

model Institution {
  id               String   @id @default(cuid())
  name             String
  currentYearLabel String? // e.g. "תשפ״ו", set on institution creation or the first year-rollover
  logoDataUrl      String? // data: URL, shown to this institution's users after login
  createdAt        DateTime @default(now())

  users     User[]
  grades    Grade[]
  semesters Semester[]
}

// A semester is the unit that "End Semester" and "Year Rollover" archive.
// Exactly one semester per institution has endedAt = null at any time - the
// active one that new AttendanceEvents attach to. Ending it (directly, or as
// part of a year rollover) closes it and opens a new one; the closed
// semester's events remain in place (tagged by semesterId) as the archive -
// nothing is ever deleted.
model Semester {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  yearLabel     String // e.g. "תשפ״ו"
  term          Int // 1 or 2
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  plannedEndDate String? // 'YYYY-MM-DD' - expected end date, set by the institution so study-day-based indicators have a fixed denominator
  nextPlannedEndDate String? // 'YYYY-MM-DD' - pre-set expected end date for the NEXT semester, applied automatically when this one ends (unless overridden then)
  events        AttendanceEvent[]

  @@index([institutionId])
}

model User {
  id            String       @id @default(cuid())
  username      String       @unique
  passwordHash  String
  fullName      String
  role          String
  email         String?
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime     @default(now())
}

model Grade {
  id            String      @id @default(cuid())
  name          String
  color         String
  order         Int         @default(0)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  classes       ClassRoom[]
  createdAt     DateTime    @default(now())

  @@unique([institutionId, name])
}

model ClassRoom {
  id        String    @id @default(cuid())
  name      String
  gradeId   String
  grade     Grade     @relation(fields: [gradeId], references: [id])
  students  Student[]
  createdAt DateTime  @default(now())

  // Set when this class graduates out during a year rollover (was the
  // top-order grade). Archived classes are frozen and hidden from the
  // regular grades/classes views, but stay browsable in the archive.
  archived          Boolean   @default(false)
  archivedAt        DateTime?
  archivedYearLabel String? // the institution's yearLabel at the time of archiving

  // Scoped by `archived` too: once a class graduates out, its (gradeId,
  // name) slot must free up so a newly-promoted class can reuse that name
  // (e.g. this year's "יב1" moving into last year's, now-archived, יב1's spot).
  @@unique([gradeId, name, archived])
}

model Student {
  id         String @id @default(cuid())
  fullName   String
  nationalId String
  classId    String
  classRoom  ClassRoom @relation(fields: [classId], references: [id])

  // semester-wide totals
  totalLateCount           Int @default(0)
  totalLateApprovedCount   Int @default(0) // subset of totalLateCount: late events marked "with permission"
  totalLateUnapprovedCount Int @default(0) // subset of totalLateCount: late events marked "without permission"
  totalAbsenceCount        Int @default(0)
  totalReleaseCount        Int @default(0)

  // "cycle" of 8 lates before an assignment is required
  cycleLateCount        Int     @default(0)
  needsAssignment       Boolean @default(false)
  assignmentsRequired   Int     @default(0)
  assignmentsSubmitted  Int     @default(0)
  blocked               Boolean @default(false)

  events    AttendanceEvent[]
  createdAt DateTime          @default(now())
}

model AttendanceEvent {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  type       String // 'LATE' | 'ABSENCE' | 'RELEASE'
  date       String // YYYY-MM-DD
  time       String? // HH:mm - relevant for LATE
  overflow   Boolean   @default(false) // true = a LATE recorded while student is blocked (9th+ in cycle)
  lateApproved Boolean? // for type='LATE' only: true = with permission, false = without permission
  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])
  createdBy  String?
  createdAt  DateTime  @default(now())

  @@index([semesterId])
}
